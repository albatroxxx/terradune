# Terraform workspace artifacts (examples are real workspaces)
**/.terraform/
**/.terradune/
/.cache/
/dist/
*.tfstate
*.tfstate.backup
# ...except the platform example, whose whole point is to ship already applied.
# It is generated by examples/tools/fakeapply.py, never by a real apply.
!examples/platform/terraform.tfstate
!examples/layered/terraform.tfstate
!examples/estate/terraform.tfstate
examples/simple/greeting.txt
examples/modular/roster.txt
examples/modular/pets/note.txt

# Build output
/terradune

# Stale lock files left when a plan is interrupted
*.tfstate.lock.info

# GoReleaser build output
/dist/
